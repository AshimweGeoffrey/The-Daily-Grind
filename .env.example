# E-Commerce Application - Environment Variables Example
# Copy this file to .env and customize the values

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ecommercedb?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=changeme

# Server Configuration
PORT=8080

# Logging
LOG_LEVEL=INFO

# Security
JWT_SECRET=your_jwt_secret_key_should_be_at_least_32_characters_long
JWT_EXPIRATION=86400000
SESSION_TIMEOUT=30

# API Configuration
API_BASE_URL=http://localhost:8080
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60

# File Upload
FILE_UPLOAD_MAX_SIZE=10MB
FILE_UPLOAD_MAX_REQUEST=10MB
FILE_UPLOAD_PATH=/path/to/upload/directory
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.gif

# Email Configuration
EMAIL_FROM=noreply@example.com
EMAIL_HTML_ENABLED=true

# Feature Flags
ENABLE_WISHLIST=true
ENABLE_PRODUCT_COMPARISON=false
ENABLE_RECENTLY_VIEWED=true

# Debug Mode (set to false in production)
DEBUG_MODE=false
